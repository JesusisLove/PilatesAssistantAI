    │
    ├── 📁 utils/                      # 工具函数
    │   ├── 📄 storage.js              # 本地存储工具
    │   ├── 📄 dateHelper.js           # 日期处理工具
    │   ├── 📄 formatters.js           # 数据格式化工具
    │   └── 📄 validators.js           # 数据验证工具
    │
